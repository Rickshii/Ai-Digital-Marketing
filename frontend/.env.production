# ============================================================
# PRODUCTION ENVIRONMENT - Frontend (Vercel)
# ============================================================
# IMPORTANT: Set VITE_API_URL in your Vercel dashboard under:
#   Project Settings > Environment Variables
#
# Value should be your Railway backend URL, e.g.:
#   VITE_API_URL=https://your-backend.up.railway.app
#
# Do NOT use /api here — that would route back to Vercel itself.
# This file is intentionally left without a value so the build
# uses what you configure in the Vercel dashboard.
# ============================================================
VITE_API_URL=
