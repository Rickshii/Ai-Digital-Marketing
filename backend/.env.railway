# ============================================================
# Railway Environment Variables
# Copy these into your Railway project's "Variables" section
# ============================================================

# REQUIRED: Generate a strong secret key
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here

# REQUIRED: Railway will auto-provide this when you add PostgreSQL plugin
# It looks like: postgresql://postgres:password@containers-xxx.railway.app:5432/railway
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to false when using Railway's PostgreSQL plugin
USE_SQLITE_FALLBACK=false

# Optional: Razorpay payment keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
