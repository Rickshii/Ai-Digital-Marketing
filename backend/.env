PROJECT_NAME="AI Digital Marketing Consultant SaaS Platform"
SECRET_KEY="supersecretkeyforlocaldevelopmentonlychangeinproductionenv"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_marketing"

# If PostgreSQL is not available, set this to true to fallback to sqlite
USE_SQLITE_FALLBACK=true
SQLITE_DATABASE_URL="sqlite:///./ai_marketing.db"
