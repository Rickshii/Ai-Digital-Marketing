# Environments — keep .env.production committed (only has placeholders, no secrets)
# Real secrets are set in Vercel/Railway dashboards, NOT in these files.
.env
.env.local
.env.development
# .env.production is intentionally NOT ignored — it contains only comments/placeholders

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Node
node_modules/
dist/
build/
.next/

# SQLite databases (don't commit local DB)
*.sqlite3
*.db

# Uploaded files (don't commit user uploads to git)
backend/uploads/avatars/
backend/uploads/proofs/
backend/uploads/qrs/
backend/uploads/temp/

# Alembic pycache
backend/alembic/__pycache__/
backend/alembic/versions/__pycache__/