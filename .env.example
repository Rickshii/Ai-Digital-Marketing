# .env.example - copy to .env for local development
# Default: local Postgres (change to your DB or use sqlite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_marketing
# Example Railway host (use for deployment on Railway; keep commented for local use)
# DATABASE_URL=postgresql://postgres:postgres@postgres.railway.internal:5432/ai_marketing

# If you prefer to use the included sqlite fallback for local dev:
USE_SQLITE_FALLBACK=false
SQLITE_DATABASE_URL=sqlite:///./ai_marketing.db

# App secret (change in production)
SECRET_KEY=change_this_in_production

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=uploads
