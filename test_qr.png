import base64

# Small 1x1 black pixel PNG image in base64
png_b64 = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
png_data = base64.b64decode(png_b64)

with open("test_qr.png", "wb") as f:
    f.write(png_data)

print("Generated test_qr.png successfully!")
